<Window x:Class="TomatoTimerPro.Views.Dialogs.PlanEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sketch="clr-namespace:TomatoTimerPro.Views.Components.Sketch"
        Title="{Binding EditorTitle}" Width="760" Height="700" MinWidth="650" MinHeight="470"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource HandwritingFont}" Foreground="{StaticResource InkBrush}"
        UseLayoutRounding="True" Closing="OnWindowClosing">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <Style x:Key="DurationPreset" TargetType="Button" BasedOn="{StaticResource SoftButton}">
            <Setter Property="Padding" Value="11,7" /><Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,7,0" /><Setter Property="BorderBrush" Value="#CEBFA1" />
            <Setter Property="Background" Value="#FFFCF4" />
        </Style>
    </Window.Resources>
    <sketch:SketchBorder Margin="9" Background="#FAF5E9" BorderBrush="#4C443A" BorderThickness="1.7" CornerRadius="15" Padding="27,24" sketch:SketchMotion.Enter="True">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="OnHeaderMouseLeftButtonDown" Background="Transparent" Margin="0,0,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><sketch:SketchIcon Kind="pen" Width="27" Height="27" Stroke="#A47758" Margin="0,0,10,0" /><TextBlock Text="{Binding EditorTitle}" FontSize="27" FontWeight="Bold" /></StackPanel>
                    <TextBlock Text="{Binding DateTitle}" FontSize="15" Foreground="#977858" Margin="2,11,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding CancelCommand}" ToolTip="关闭 · Esc" AutomationProperties.Name="关闭计划编辑" Width="32" Height="32" Padding="8" Background="Transparent" BorderThickness="0" VerticalAlignment="Top"><sketch:SketchIcon Kind="close" Width="16" Height="16" /></Button>
            </Grid>
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="先写下想做的事，再留一点专注时间。" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="14" Foreground="#977858" VerticalAlignment="Center" sketch:SketchMotion.Change="{Binding CountText}" />
            </Grid>
            <ScrollViewer x:Name="PlanScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,2,8,4">
                <StackPanel>
                    <ItemsControl x:Name="PlanRows" ItemsSource="{Binding Plans}" IsEnabled="{Binding CanEdit}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <sketch:SketchBorder Background="#FFFCF4" BorderBrush="#C4B493" BorderThickness="1" CornerRadius="10" Padding="18,15" Margin="1,0,1,14" sketch:SketchMotion.Enter="True">
                                    <Grid Loaded="OnPlanRowLoaded">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><sketch:SketchIcon Kind="pin" Width="17" Height="17" Stroke="#A48C64" Margin="0,0,7,0" /><TextBlock Text="计划内容" FontSize="14" Foreground="#977858" /></StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <ComboBox ItemsSource="{Binding StatusChoices}" SelectedItem="{Binding SelectedStatus}" DisplayMemberPath="Label" Width="112" MinHeight="34" Padding="9,5" FontSize="14" AutomationProperties.Name="计划状态" />
                                            <Button Command="{Binding DeleteCommand}" ToolTip="移除这一项" Padding="7" Width="32" Height="32" Margin="9,0,0,0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="删除这一项计划"><sketch:SketchIcon Kind="trash" Width="17" Height="17" Stroke="#AE634D" /></Button>
                                        </StackPanel>
                                        <TextBox x:Name="PlanTitleInput" Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" MinHeight="68" Margin="0,12,0,0" FontSize="20" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Background="#FCF8EB" AutomationProperties.Name="计划内容" />
                                        <Button Grid.Row="2" Grid.ColumnSpan="2" Command="{Binding AddPomodoroCommand}" HorizontalAlignment="Left" Padding="0,9" Margin="0,7,0,0" Background="Transparent" BorderThickness="0" Foreground="#798464" AutomationProperties.Name="为这项计划添加番茄钟">
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasPomodoro}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                            <StackPanel Orientation="Horizontal"><sketch:SketchIcon Kind="tomato" Width="19" Height="19" Stroke="#798464" Margin="0,0,7,0" /><TextBlock Text="添加番茄钟" Foreground="#798464" /><TextBlock Text=" · 可选" Foreground="#A29783" FontSize="13" VerticalAlignment="Center" /></StackPanel>
                                        </Button>
                                        <sketch:SketchBorder Grid.Row="2" Grid.ColumnSpan="2" Background="#F0F1E4" BorderBrush="#BBC1A5" BorderThickness="0.8" CornerRadius="7" Padding="13,12" Margin="0,14,0,0" sketch:SketchMotion.Enter="True">
                                            <sketch:SketchBorder.Style><Style TargetType="sketch:SketchBorder"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasPomodoro}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></sketch:SketchBorder.Style>
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,11">
                                                    <Button DockPanel.Dock="Right" Command="{Binding RemovePomodoroCommand}" ToolTip="移除番茄钟，保留计划内容" Background="Transparent" BorderThickness="0" Padding="4" AutomationProperties.Name="移除番茄钟"><sketch:SketchIcon Kind="close" Width="13" Height="13" Stroke="#849075" /></Button>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><sketch:SketchIcon Kind="tomato" Width="20" Height="20" Stroke="#798464" Margin="0,0,7,0" /><TextBlock Text="为这件事专注一会儿" FontSize="14" Foreground="#6E7D60" /></StackPanel>
                                                </DockPanel>
                                                <WrapPanel VerticalAlignment="Center">
                                                    <Button Content="15 分钟" Command="{Binding ShortFocusCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DurationPreset}"><Style.Triggers><DataTrigger Binding="{Binding DurationMinutes}" Value="15"><Setter Property="Background" Value="#DCE4CD" /><Setter Property="BorderBrush" Value="#879573" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                                    <Button Content="25 分钟" Command="{Binding StandardFocusCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DurationPreset}"><Style.Triggers><DataTrigger Binding="{Binding DurationMinutes}" Value="25"><Setter Property="Background" Value="#DCE4CD" /><Setter Property="BorderBrush" Value="#879573" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                                    <Button Content="45 分钟" Command="{Binding LongFocusCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DurationPreset}"><Style.Triggers><DataTrigger Binding="{Binding DurationMinutes}" Value="45"><Setter Property="Background" Value="#DCE4CD" /><Setter Property="BorderBrush" Value="#879573" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                                    <TextBlock Text="自定" FontSize="13" Foreground="#849075" VerticalAlignment="Center" Margin="4,0,7,0" />
                                                    <TextBox Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}" Width="72" Padding="7,6" FontSize="15" VerticalContentAlignment="Center" ToolTip="0.01 至 1440 分钟" AutomationProperties.Name="专注时长（分钟）" />
                                                    <TextBlock Text="分钟" FontSize="13" Foreground="#849075" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </sketch:SketchBorder>
                                    </Grid>
                                </sketch:SketchBorder>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Command="{Binding AddCommand}" Background="#F5EEDB" BorderBrush="#C5B592" Padding="12,12" Margin="1,0,1,4" ToolTip="再写一项 · Ctrl+N"><StackPanel Orientation="Horizontal"><sketch:SketchIcon Kind="plus" Width="17" Height="17" Stroke="#977858" Margin="0,0,8,0" /><TextBlock Text="再写一项计划" Foreground="#977858" /></StackPanel></Button>
                </StackPanel>
            </ScrollViewer>
            <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Style="{StaticResource InlineStatus}" Foreground="#AE634D" Margin="1,10,1,0" />
            <Grid Grid.Row="4" Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Ctrl+N 添加 · Ctrl+S 保存" FontSize="13" Foreground="#A0927B" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="取消" Command="{Binding CancelCommand}" Style="{StaticResource TextButton}" MinWidth="66" Margin="0,0,12,0" />
                    <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" MinWidth="126"><StackPanel Orientation="Horizontal"><sketch:SketchIcon Kind="check" Width="18" Height="18" Margin="0,0,8,0" /><TextBlock Text="保存计划" /></StackPanel></Button>
                </StackPanel>
            </Grid>
        </Grid>
    </sketch:SketchBorder>
</Window>
