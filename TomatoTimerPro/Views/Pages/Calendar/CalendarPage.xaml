<UserControl x:Class="TomatoTimerPro.Views.Pages.Calendar.CalendarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:schedule="clr-namespace:TomatoTimerPro.Views.Components.Schedule"
             xmlns:sketch="clr-namespace:TomatoTimerPro.Views.Components.Sketch">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,24,30,20">
            <TextBlock Text="日历与计划" Style="{StaticResource PageTitle}" />
            <schedule:DayTimeAllocation DataContext="{Binding TimeAllocation}" Margin="0,0,0,18">
                <schedule:DayTimeAllocation.Style><Style TargetType="schedule:DayTimeAllocation"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasPlans}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></schedule:DayTimeAllocation.Style>
            </schedule:DayTimeAllocation>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                <sketch:SketchBorder Style="{StaticResource Card}" Padding="16,20" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="2,0,2,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Button Command="{Binding PreviousMonthCommand}" ToolTip="上个月" Width="32" Height="32" Padding="7"><sketch:SketchIcon Kind="back" Width="16" Height="16" /></Button>
                            <TextBlock Grid.Column="1" Text="{Binding MonthTitle}" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" sketch:SketchMotion.Change="{Binding MonthTitle}" />
                            <Button Grid.Column="2" Command="{Binding NextMonthCommand}" ToolTip="下个月" Width="32" Height="32" Padding="7"><sketch:SketchIcon Kind="forward" Width="16" Height="16" /></Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Weekdays}" Margin="0,0,0,9">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="14" /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Selecting a date refreshes the day models so their selected and plan markers stay in sync.
                             The calendar grid is a stable control, so replaying list-entry motion here makes every
                             click look like the whole month is reloading. Keep list motion for the plan lists, but
                             let the 42 day cells update in place. -->
                        <ItemsControl ItemsSource="{Binding Days}" IsEnabled="{Binding CanEdit}" sketch:SketchListMotion.Enabled="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" Rows="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding SelectCommand}" ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Description}" Margin="2,3" Padding="1,6" Height="60">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SoftButton}">
                                                <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False"><Setter Property="Opacity" Value="0.35" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter Property="BorderThickness" Value="1.3" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{StaticResource MarkerBrush}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <sketch:SketchIcon Kind="notes" Width="11" Height="11" Stroke="#6E8665" VerticalAlignment="Center" Margin="0,0,3,0" ToolTip="有日志">
                                                    <sketch:SketchIcon.Style><Style TargetType="sketch:SketchIcon"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasJournal}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></sketch:SketchIcon.Style>
                                                </sketch:SketchIcon>
                                                <TextBlock Text="{Binding Number}" FontFamily="Segoe Print" FontSize="18" />
                                                <Ellipse Width="5" Height="5" Fill="#C75B50" Margin="4,0,0,7" VerticalAlignment="Top">
                                                    <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasPendingPlans}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                                </Ellipse>
                                            </StackPanel>
                                            <TextBlock Text="{Binding PlanHint}" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Margin="5,16,5,0">
                            <Button DockPanel.Dock="Right" Content="回到今天" Command="{Binding TodayCommand}" Style="{StaticResource TextButton}" Padding="6,4" />
                        </DockPanel>
                    </StackPanel>
                </sketch:SketchBorder>
                <sketch:SketchBorder Grid.Column="2" Style="{StaticResource Card}" Background="#FFF6D9" Padding="19,20" VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"><sketch:SketchIcon Kind="calendar" Width="21" Height="21" Margin="0,0,8,0" /><TextBlock Text="{Binding ListTitle}" FontSize="21" FontWeight="Bold" /></StackPanel>
                        <TextBlock Text="{Binding ListSubtitle}" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,9,0,12" />
                        <Button x:Name="OpenDayJournal" Content="查看当天日志" Command="{Binding OpenSelectedJournalCommand}" Margin="0,0,0,12">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SoftButton}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedHasJournal}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="日程" Command="{Binding ShowActiveCommand}" Padding="5,5"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource TextButton}"><Style.Triggers><DataTrigger Binding="{Binding IsActiveBox}" Value="True"><Setter Property="Background" Value="#E8D8AE" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                            <Button Content="{Binding OnHoldLabel}" Command="{Binding ShowOnHoldCommand}" Padding="5,5"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource TextButton}"><Style.Triggers><DataTrigger Binding="{Binding IsOnHoldBox}" Value="True"><Setter Property="Background" Value="#E8D8AE" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                            <Button Content="{Binding TrashLabel}" Command="{Binding ShowTrashCommand}" Padding="5,5"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource TextButton}"><Style.Triggers><DataTrigger Binding="{Binding IsTrashBox}" Value="True"><Setter Property="Background" Value="#E8D8AE" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                        </WrapPanel>
                        <StackPanel>
                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsActiveBox}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                                <Button Command="{Binding AddPlanCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"><StackPanel Orientation="Horizontal"><sketch:SketchIcon Kind="plus" Width="17" Height="17" Margin="0,0,8,0" /><TextBlock Text="写个新计划" /></StackPanel></Button>
                                <Button Grid.Column="1" Command="{Binding EditSelectedCommand}" Style="{StaticResource SoftButton}" Padding="10" ToolTip="整理当天的全部计划" AutomationProperties.Name="编辑当天全部计划"><sketch:SketchIcon Kind="pen" Width="19" Height="19" /></Button>
                            </Grid>
                            <TextBlock Text="{Binding SelectedProgress}" Style="{StaticResource Caption}" FontSize="13" Margin="0,0,0,12" />
                        </StackPanel>
                        <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding VisiblePlans}" ItemTemplate="{StaticResource PlanListTemplate}" IsEnabled="{Binding CanEdit}" />
                        </ScrollViewer>
                        <TextBlock Text="暂无计划" Margin="0,10,0,15">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding VisiblePlans.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource InlineStatus}" />
                        <Button Content="重新读取计划" Command="{Binding ReloadCommand}" Margin="0,10,0,0">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SoftButton}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsLoaded}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                    </StackPanel>
                </sketch:SketchBorder>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
