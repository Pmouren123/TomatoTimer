<UserControl x:Class="TomatoTimerPro.Views.Pages.Timer.TimerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:countdown="clr-namespace:TomatoTimerPro.Views.Components.Countdown"
             xmlns:schedule="clr-namespace:TomatoTimerPro.Views.Components.Schedule"
             xmlns:sketch="clr-namespace:TomatoTimerPro.Views.Components.Sketch">
    <UserControl.InputBindings><KeyBinding Key="Enter" Modifiers="Control" Command="{Binding StartCommand}" /></UserControl.InputBindings>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,24,30,20">
            <TextBlock Text="专注计时" Style="{StaticResource PageTitle}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button Content="日程模式" Command="{Binding SelectScheduleModeCommand}" Padding="17,9" Margin="0,0,10,0">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SoftButton}"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="#C6B79E" /><Style.Triggers><DataTrigger Binding="{Binding IsScheduleMode}" Value="True"><Setter Property="Background" Value="#E8D8AE" /><Setter Property="BorderBrush" Value="#8F7A59" /></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
                <Button Content="休闲模式" Command="{Binding SelectLeisureModeCommand}" Padding="17,9">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SoftButton}"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="#C6B79E" /><Style.Triggers><DataTrigger Binding="{Binding IsLeisureMode}" Value="True"><Setter Property="Background" Value="#DCE4D0" /><Setter Property="BorderBrush" Value="#8C9A79" /></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
            </StackPanel>
            <schedule:DayTimeAllocation x:Name="DayAllocation" DataContext="{Binding TimeAllocation}" Margin="0,0,0,18">
                <schedule:DayTimeAllocation.Style><Style TargetType="schedule:DayTimeAllocation"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.IsScheduleMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" /><Condition Binding="{Binding HasPlans}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></schedule:DayTimeAllocation.Style>
            </schedule:DayTimeAllocation>
            <Grid x:Name="TimerLayout" SizeChanged="OnTimerLayoutSizeChanged">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="PlannerColumn" Width="260" /><ColumnDefinition x:Name="PlannerGap" Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="SetupGap" Width="16" /><ColumnDefinition x:Name="SetupColumn" Width="240" /></Grid.ColumnDefinitions>
                <sketch:SketchBorder x:Name="PlannerCard" Grid.RowSpan="2" DataContext="{Binding Planner}" Style="{StaticResource Card}" Padding="17,20" VerticalAlignment="Top" Background="#FFF6D9">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"><sketch:SketchIcon Kind="calendar" Width="23" Height="23" Stroke="#977858" Margin="0,0,8,0" /><TextBlock Text="今日计划" FontSize="22" FontWeight="Bold" /></StackPanel>
                        <TextBlock Text="{Binding TodayLabel}" FontSize="14" Foreground="#977858" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding TodayProgress}" FontSize="13" Foreground="{StaticResource SuccessBrush}" Margin="0,8,0,14" />
                        <ScrollViewer MaxHeight="365" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding TodayPlans}" ItemTemplate="{StaticResource PlanListTemplate}" IsEnabled="{Binding CanEdit}" />
                        </ScrollViewer>
                        <TextBlock Text="暂无计划" Margin="0,12,0,20">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding TodayPlans.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
                            <Button Command="{Binding AddTodayPlanCommand}" Style="{StaticResource SoftButton}" Padding="10,10" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><sketch:SketchIcon Kind="plus" Width="15" Height="15" Margin="0,0,6,0" /><TextBlock Text="写个新计划" FontSize="14" /></StackPanel></Button>
                            <Button Grid.Column="1" Command="{Binding EditTodayCommand}" Style="{StaticResource TextButton}" Padding="8" ToolTip="整理今日计划" AutomationProperties.Name="编辑今日全部计划"><sketch:SketchIcon Kind="pen" Width="18" Height="18" /></Button>
                        </Grid>
                    </StackPanel>
                </sketch:SketchBorder>
                <StackPanel Grid.Column="2">
                    <sketch:SketchBorder x:Name="EmptyScheduleCard" Padding="30,50">
                        <sketch:SketchBorder.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ShowScheduleEmptyState}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></sketch:SketchBorder.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <sketch:SketchIcon Kind="calendar" Width="40" Height="40" Stroke="#A08A6B" HorizontalAlignment="Center" Margin="0,0,0,18" />
                            <TextBlock Text="今天还没有可执行的番茄钟计划" Style="{StaticResource Caption}" TextAlignment="Center" />
                            <Button Content="＋ 添加计划" Command="{Binding AddSchedulePlanCommand}" Style="{StaticResource SoftButton}" HorizontalAlignment="Center" Margin="0,18,0,0" />
                        </StackPanel>
                    </sketch:SketchBorder>
                    <sketch:SketchBorder x:Name="ClockCard" Padding="27,22,27,22">
                        <sketch:SketchBorder.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Style.Triggers><DataTrigger Binding="{Binding ShowScheduleEmptyState}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></sketch:SketchBorder.Style>
                        <StackPanel>
                            <DockPanel>
                                <sketch:SketchBorder DockPanel.Dock="Left" Background="{StaticResource AccentSoftBrush}" CornerRadius="5" Padding="10,5">
                                    <TextBlock Text="{Binding StatusText}" Foreground="#78664F" FontSize="14" />
                                </sketch:SketchBorder>
                                <sketch:SketchIcon Kind="timer" Width="30" Height="30" Stroke="#A08A6B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding CurrentTaskTitle}" HorizontalAlignment="Center" FontFamily="{StaticResource HandwritingFont}" FontSize="20" Margin="0,21,0,0" TextTrimming="CharacterEllipsis" MaxWidth="350" />
                            <TextBlock Text="{Binding RemainingText}" FontFamily="Segoe Print" FontSize="64" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,4" Foreground="#433B34" />
                            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="100" Margin="0,0,0,21" />
                            <Button Command="{Binding StartCommand}" Padding="18,12" ToolTip="开始专注 · Ctrl+Enter">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                <StackPanel Orientation="Horizontal"><sketch:SketchIcon Kind="play" Width="18" Height="18" Stroke="#433B34" Margin="0,0,8,0" /><TextBlock FontFamily="{StaticResource HandwritingFont}" FontSize="18"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="开始专注" /><Style.Triggers><DataTrigger Binding="{Binding IsScheduleMode}" Value="True"><Setter Property="Text" Value="开始日程" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
                            </Button>
                            <Grid>
                                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button Command="{Binding PauseResumeCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SoftButton}">
                                            <Setter Property="Content" Value="暂停计时" />
                                            <Style.Triggers><DataTrigger Binding="{Binding IsPaused}" Value="True"><Setter Property="Content" Value="继续专注" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Grid.Column="2" Content="结束本次" Command="{Binding EndTaskCommand}" />
                            </Grid>
                        </StackPanel>
                    </sketch:SketchBorder>
                    <sketch:SketchBorder Padding="17,16" Margin="0,16,0,0">
                        <sketch:SketchBorder.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsScheduleMode}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding ShowScheduleEmptyState}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></sketch:SketchBorder.Style>
                        <StackPanel>
                            <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Schedule.PositionText}" FontFamily="Segoe Print" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" /><TextBlock Text="日程进度" FontSize="18" /></DockPanel>
                            <TextBlock Text="{Binding Schedule.RestText}" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0" />
                            <ProgressBar Value="{Binding Schedule.Progress, Mode=OneWay}" Minimum="0" Maximum="100" Height="7" Margin="0,11,0,12" />
                            <ScrollViewer MaxHeight="185" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Schedule.Entries}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <sketch:SketchBorder Padding="6,8" Margin="0,1" CornerRadius="5" BorderThickness="0">
                                            <sketch:SketchBorder.Style><Style TargetType="sketch:SketchBorder"><Setter Property="Background" Value="Transparent" /><Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Background" Value="#F1D5BC" /></DataTrigger><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Opacity" Value="0.5" /></DataTrigger></Style.Triggers></Style></sketch:SketchBorder.Style>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Path Data="M 0,0 L 7,4 0,8 Z" Fill="#96714C" VerticalAlignment="Center"><Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Path.Style></Path>
                                                <Path Data="M 0,5 L 3,8 9,0" Stroke="#77876B" StrokeThickness="1.5" VerticalAlignment="Center"><Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Path.Style></Path>
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </sketch:SketchBorder>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </sketch:SketchBorder>
                </StackPanel>
                <sketch:SketchBorder x:Name="SetupCard" Grid.Column="4" Style="{StaticResource Card}" Padding="18" VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15"><sketch:SketchIcon Kind="pen" Width="22" Height="22" Stroke="#9B7954" Margin="0,0,9,0" /><TextBlock Text="本次专注" FontFamily="{StaticResource HandwritingFont}" FontSize="20" /></StackPanel>
                        <TextBlock Text="工作区" Style="{StaticResource FieldLabel}" />
                        <sketch:SketchBorder Background="#F6EEDC" CornerRadius="7" Padding="12">
                            <TextBlock Text="{Binding WorkspaceName}" FontSize="15" TextTrimming="CharacterEllipsis" ToolTip="{Binding WorkspacePath}" />
                        </sketch:SketchBorder>
                        <Button Content="选择工作区" Command="{Binding SelectWorkspaceCommand}" Style="{StaticResource TextButton}" HorizontalAlignment="Left" Padding="0,9" Margin="0,1,0,17" />
                        <StackPanel>
                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsLeisureMode}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <TextBlock Text="任务名称" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding TaskTitle, UpdateSourceTrigger=PropertyChanged}" ToolTip="给本次专注起一个名称" MaxLength="160" Margin="0,0,0,19" />
                        </StackPanel>
                        <TextBlock Text="专注时长（休闲与日程共用）" Style="{StaticResource FieldLabel}" />
                        <countdown:DurationInput DataContext="{Binding Duration}" Margin="0,0,0,19" />
                        <StackPanel Margin="0,0,0,17">
                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsScheduleMode}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <TextBlock Text="番茄钟之间的休息（分钟）" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ScheduleRestMinutes, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" Padding="7,8" ToolTip="日程中每个番茄钟完成后等待的休息时间" />
                        </StackPanel>
                        <TextBlock Text="开始铃声" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding AlarmChoices}" SelectedItem="{Binding SelectedStartAlarm}" Margin="0,0,0,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="15" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                        <TextBlock Text="结束铃声" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding AlarmChoices}" SelectedItem="{Binding SelectedAlarm}" Margin="0,0,0,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="15" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Content="试听铃声" Command="{Binding PreviewAlarmCommand}" Padding="5,8" FontSize="14" Background="#F0E2BC" />
                            <Button Grid.Column="2" Content="停止铃声" Command="{Binding StopAlarmCommand}" Padding="5,8" FontSize="14" />
                        </Grid>
                    </StackPanel>
                </sketch:SketchBorder>
            </Grid>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource InlineStatus}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
