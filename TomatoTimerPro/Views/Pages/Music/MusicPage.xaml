<UserControl x:Class="TomatoTimerPro.Views.Pages.Music.MusicPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sketch="clr-namespace:TomatoTimerPro.Views.Components.Sketch">
    <Grid Margin="30,30,30,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="音乐与铃声" Style="{StaticResource PageTitle}" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="275" /></Grid.ColumnDefinitions>
            <sketch:SketchBorder Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,18">
                        <Button DockPanel.Dock="Right" Command="{Binding ImportCommand}" Style="{StaticResource PrimaryButton}" Padding="12,9" FontSize="14"><StackPanel Orientation="Horizontal"><sketch:SketchIcon Kind="plus" Width="16" Height="16" Margin="0,0,6,0" /><TextBlock Text="导入音频" FontFamily="{StaticResource HandwritingFont}" FontSize="15" /></StackPanel></Button>
                        <TextBlock Text="音乐库" FontFamily="{StaticResource HandwritingFont}" FontSize="21" FontWeight="Bold" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <sketch:SketchBorder Background="#F0DFC0" Width="27" Height="32" CornerRadius="5" BorderBrush="#B59A70" BorderThickness="0.8" VerticalAlignment="Center"><sketch:SketchIcon Kind="music" Width="21" Height="21" Stroke="#9B7954" HorizontalAlignment="Center" VerticalAlignment="Center" /></sketch:SketchBorder>
                                        <TextBlock Grid.Column="1" Margin="8,0,5,0" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" />
                                        <TextBlock Grid.Column="2" Foreground="{StaticResource MutedBrush}" FontSize="14" VerticalAlignment="Center" Margin="7,0,0,0">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="" /><Style.Triggers><DataTrigger Binding="{Binding IsAvailable}" Value="False"><Setter Property="Text" Value="不可用" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Tracks.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <sketch:SketchBorder Background="#F1E2BD" CornerRadius="10" BorderBrush="#B39A70" BorderThickness="1" Width="76" Height="76" HorizontalAlignment="Center" Margin="0,0,0,17"><sketch:SketchIcon Kind="music" Width="47" Height="47" Stroke="#947B51" HorizontalAlignment="Center" VerticalAlignment="Center" /></sketch:SketchBorder>
                            <TextBlock Text="暂无音频" FontFamily="{StaticResource HandwritingFont}" FontSize="19" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0">
                        <Button Content="移除条目" Command="{Binding RemoveCommand}" Style="{StaticResource TextButton}" FontSize="13" />
                        <Button Content="重新定位文件" Command="{Binding RelinkCommand}" Style="{StaticResource TextButton}" FontSize="13" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </sketch:SketchBorder>
            <StackPanel Grid.Column="2">
                <sketch:SketchBorder Style="{StaticResource Card}" Padding="22">
                    <StackPanel>
                        <TextBlock Text="正在播放" Style="{StaticResource FieldLabel}" />
                        <sketch:SketchBorder Background="#EFE2BC" BorderBrush="#A28A5E" BorderThickness="1" CornerRadius="8" Height="125" Margin="0,8,0,18">
                            <sketch:SketchIcon Kind="music" Width="80" Height="80" Stroke="#786347" StrokeThickness="2.5" />
                        </sketch:SketchBorder>
                        <TextBlock Text="{Binding CurrentTrackTitle, TargetNullValue=选择一首音乐}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,7" />
                        <TextBlock Text="{Binding PlaybackStatus}" Style="{StaticResource Caption}" Margin="0,0,0,13" />
                        <Slider Value="{Binding PositionSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="{Binding DurationSeconds}" AutoToolTipPlacement="None" />
                        <DockPanel Margin="2,4,2,16"><TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" FontSize="12" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding PositionText}" FontSize="12" Foreground="{StaticResource MutedBrush}" /></DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Content="上一首" Command="{Binding PreviousCommand}" Style="{StaticResource SoftButton}" Padding="4,11" FontSize="13" />
                            <Button Grid.Column="2" Command="{Binding PlayPauseCommand}" Padding="4,11" FontSize="13">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Content" Value="播放" /><Style.Triggers><DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Content" Value="暂停" /></DataTrigger></Style.Triggers></Style></Button.Style>
                            </Button>
                            <Button Grid.Column="4" Content="下一首" Command="{Binding NextCommand}" Style="{StaticResource SoftButton}" Padding="4,11" FontSize="13" />
                        </Grid>
                        <Button Content="停止播放" Command="{Binding StopCommand}" Style="{StaticResource TextButton}" FontSize="13" Margin="0,8,0,0" />
                        <Path Data="M 0,1 L 45,0 90,2 140,0 220,1" Stroke="#B7A68B" StrokeThickness="0.8" Stretch="Fill" Height="2" Margin="0,13,0,16" />
                        <TextBlock Text="音乐音量" Style="{StaticResource FieldLabel}" />
                        <Slider Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="1" TickFrequency="0.05" AutoToolTipPlacement="None" />
                    </StackPanel>
                </sketch:SketchBorder>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button Content="试听铃声" Command="{Binding PreviewAlarmCommand}" FontSize="14" Padding="5,9" />
                    <Button Grid.Column="2" Content="停止铃声" Command="{Binding StopAlarmCommand}" FontSize="14" Padding="5,9" />
                </Grid>
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Style="{StaticResource InlineStatus}" />
    </Grid>
</UserControl>
