<UserControl x:Class="TomatoTimerPro.Views.Pages.Records.RecordsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sketch="clr-namespace:TomatoTimerPro.Views.Components.Sketch">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="RecordsVisibility" />
        <Style x:Key="EditorToolButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="ToolbarGroup" TargetType="Border">
            <Setter Property="Background" Value="#FAF2DF" />
            <Setter Property="BorderBrush" Value="#D4C4A5" />
            <Setter Property="BorderThickness" Value="0.8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="4,4,2,0" />
            <Setter Property="Margin" Value="0,0,7,4" />
        </Style>
        <Style x:Key="EditorContextBar" TargetType="sketch:SketchBorder" BasedOn="{StaticResource Card}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DateChooserVisible}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <UserControl.InputBindings><KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" /></UserControl.InputBindings>
    <Grid Margin="30,30,30,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="每日日志" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Command="{Binding ReturnToTimelineCommand}" Padding="13,7" VerticalAlignment="Center" ToolTip="返回日志时间线" AutomationProperties.Name="返回日志时间线">
                <StackPanel Orientation="Horizontal"><sketch:SketchIcon Kind="previous" Width="16" Height="16" Margin="0,0,6,0" /><TextBlock Text="返回时间线" FontSize="15" /></StackPanel>
            </Button>
        </Grid>
        <sketch:SketchBorder Grid.Row="1" Style="{StaticResource EditorContextBar}" Padding="16,12" Margin="0,0,0,17">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="{Binding WorkspaceName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding WorkspacePath}" /><TextBlock Text="{Binding DailyContextText}" Style="{StaticResource Caption}" FontSize="13" /></StackPanel>
                <DatePicker Grid.Column="1" SelectedDate="{Binding SelectedDate}" Width="150" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Grid.Column="2" Content="切换工作区" Command="{Binding SelectWorkspaceCommand}" VerticalAlignment="Center" />
            </Grid>
        </sketch:SketchBorder>
        <sketch:SketchBorder Grid.Row="2" Background="#F4E6BF" BorderBrush="#BAA17C" BorderThickness="1" CornerRadius="10" Padding="13,10" Margin="0,0,0,14">
            <sketch:SketchBorder.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding RecoveryDrafts.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></sketch:SketchBorder.Style>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="恢复草稿" FontSize="14" FontWeight="Medium" Foreground="#90704A" VerticalAlignment="Center" Margin="0,0,13,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding RecoveryDrafts}" SelectedItem="{Binding SelectedRecoveryDraft}" VerticalAlignment="Center" MinHeight="34" Padding="6" ToolTip="{Binding SelectedRecoveryDraft.OriginalPath}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding OriginalPath}" TextTrimming="CharacterEllipsis" FontSize="14" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                <Button Grid.Column="2" Content="载入草稿" Command="{Binding RestoreDraftCommand}" Margin="11,0,0,0" Padding="12,8" VerticalAlignment="Center" />
            </Grid>
        </sketch:SketchBorder>
        <Grid Grid.Row="3">
            <Grid x:Name="EditorWorkspace">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="TimelineColumn" Width="270" /><ColumnDefinition x:Name="TimelineGap" Width="17" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <sketch:SketchBorder x:Name="TimelineCard" Style="{StaticResource Card}" Padding="13,17,13,14" sketch:SketchMotion.Enter="False">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel Margin="8,0,5,13">
                        <sketch:SketchIcon DockPanel.Dock="Left" Kind="timer" Width="21" Height="21" Stroke="#927857" Margin="0,0,8,0" />
                        <TextBlock Text="时间指针" FontFamily="{StaticResource HandwritingFont}" FontSize="20" />
                        <Button x:Name="CollapseSidebarButton" DockPanel.Dock="Right" Click="OnToggleSidebar" Style="{StaticResource TextButton}" Padding="5,2" ToolTip="收起时间线" AutomationProperties.Name="收起时间线"><sketch:SketchIcon Kind="sidebar" Width="18" Height="18" /></Button>
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="6,0,6,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="当天专注记录" Style="{StaticResource Caption}" FontSize="13" />
                        <Button Grid.Column="1" Content="日期索引" Command="{Binding ShowHistoryCommand}" Style="{StaticResource TextButton}" FontSize="13" Padding="4,2" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid x:Name="SessionTimeline" Visibility="{Binding SessionsVisible, Converter={StaticResource RecordsVisibility}}">
                            <ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" Margin="0,0,0,8" IsEnabled="{Binding CanEdit}" BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="64" Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="17" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeText}" FontFamily="Segoe Print" FontSize="13" Foreground="#8B765C" HorizontalAlignment="Right" Margin="0,5,0,0" />
                                            <Grid Grid.Column="1"><Border Width="1.2" Background="#C5B08A" HorizontalAlignment="Center" Margin="0,0,0,-5" /><Ellipse Width="9" Height="9" Fill="#D97962" Stroke="#9D624D" StrokeThickness="0.7" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" /></Grid>
                                            <sketch:SketchBorder Grid.Column="2" Background="#FFF8E8" BorderBrush="#D2C19F" BorderThickness="0.8" CornerRadius="7" Padding="9,7" Margin="5,0,0,0">
                                                <StackPanel><TextBlock Text="{Binding Title}" FontSize="15" TextTrimming="CharacterEllipsis" /><DockPanel Margin="0,5,0,0"><TextBlock Text="{Binding DurationText}" FontSize="12" Foreground="{StaticResource MutedBrush}" /><TextBlock Text=" · " FontSize="12" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource SuccessBrush}" /></DockPanel></StackPanel>
                                            </sketch:SketchBorder>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="今天还没有番茄钟记录" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10,26" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Sessions.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        </Grid>
                        <Grid x:Name="JournalHistory" Visibility="{Binding HistoryVisible, Converter={StaticResource RecordsVisibility}}">
                            <ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" IsEnabled="{Binding CanEdit}" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="2,5"><sketch:SketchIcon Kind="notes" Width="17" Height="17" Stroke="#6E8665" Margin="0,0,9,0" /><TextBlock Text="{Binding DateText}" FontSize="15" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                            <TextBlock Text="暂无历史日志" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10,26" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding History.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        </Grid>
                    </Grid>
                    <Button Grid.Row="3" Content="打开日志文件夹" Command="{Binding OpenFolderCommand}" Style="{StaticResource TextButton}" FontSize="13" />
                </Grid>
            </sketch:SketchBorder>
            <sketch:SketchBorder Grid.Column="2" Style="{StaticResource Card}" Padding="12" MinHeight="390" sketch:SketchMotion.Enter="False">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EditorTitle}" FontFamily="{StaticResource HandwritingFont}" FontSize="21" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                            <Border Background="#F3E5C8" BorderBrush="#D2BD94" BorderThickness="0.8" CornerRadius="5" Padding="7,3" Margin="10,0,0,0"><TextBlock Text="Markdown" FontSize="12" Foreground="#A08B6C" /></Border>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ExpandSidebarButton" Click="OnToggleSidebar" Style="{StaticResource TextButton}" Padding="6,3" Margin="0,0,8,0" Visibility="Collapsed" ToolTip="展开时间线" AutomationProperties.Name="展开时间线"><sketch:SketchIcon Kind="sidebar" Width="18" Height="18" /></Button>
                            <Border Background="#F5ECD8" BorderBrush="#D1C09F" BorderThickness="0.8" CornerRadius="6" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="VisualModeButton" Tag="visual" Click="OnModeClick" Style="{StaticResource EditorToolButton}" Margin="0" Padding="9,4" ToolTip="可视化编辑" AutomationProperties.Name="可视化编辑"><sketch:SketchIcon Kind="pen" Width="17" Height="17" /></Button>
                                    <Button x:Name="PreviewModeButton" Tag="preview" Click="OnModeClick" Style="{StaticResource EditorToolButton}" Margin="0" Padding="9,4" ToolTip="预览 Markdown 效果" AutomationProperties.Name="预览 Markdown 效果"><sketch:SketchIcon Kind="eye" Width="17" Height="17" /></Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{Binding SaveStatus}" FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <Border Grid.Row="2" Background="#F5ECD8" BorderBrush="#D1C09F" BorderThickness="0.8" CornerRadius="7" Padding="6" Margin="0,0,0,10">
                        <WrapPanel>
                            <Border Style="{StaticResource ToolbarGroup}"><StackPanel Orientation="Horizontal">
                                <Button Tag="undo" Click="OnVisualToolClick" ToolTip="撤销（Ctrl+Z）" AutomationProperties.Name="撤销" Style="{StaticResource EditorToolButton}"><sketch:SketchIcon Kind="undo" Width="17" Height="17" /></Button>
                                <Button Tag="redo" Click="OnVisualToolClick" ToolTip="重做（Ctrl+Y）" AutomationProperties.Name="重做" Style="{StaticResource EditorToolButton}"><sketch:SketchIcon Kind="redo" Width="17" Height="17" /></Button>
                            </StackPanel></Border>
                            <Border Style="{StaticResource ToolbarGroup}"><StackPanel Orientation="Horizontal">
                                <Button Tag="bold" Click="OnVisualToolClick" ToolTip="粗体（Ctrl+B）" AutomationProperties.Name="粗体" Style="{StaticResource EditorToolButton}"><sketch:SketchIcon Kind="bold" Width="17" Height="17" /></Button>
                                <Button Tag="italic" Click="OnVisualToolClick" ToolTip="斜体（Ctrl+I）" AutomationProperties.Name="斜体" Style="{StaticResource EditorToolButton}"><sketch:SketchIcon Kind="italic" Width="17" Height="17" /></Button>
                                <Button Tag="underline" Click="OnVisualToolClick" ToolTip="下划线" AutomationProperties.Name="下划线" Style="{StaticResource EditorToolButton}"><sketch:SketchIcon Kind="underline" Width="17" Height="17" /></Button>
                                <Button Tag="strike" Click="OnVisualToolClick" ToolTip="删除线" AutomationProperties.Name="删除线" Style="{StaticResource EditorToolButton}"><sketch:SketchIcon Kind="strike" Width="17" Height="17" /></Button>
                            </StackPanel></Border>
                            <Border Style="{StaticResource ToolbarGroup}"><StackPanel Orientation="Horizontal">
                                <Button Tag="h1" Click="OnVisualToolClick" ToolTip="标题 1" AutomationProperties.Name="标题 1" Style="{StaticResource EditorToolButton}"><sketch:SketchIcon Kind="heading" Width="17" Height="17" /></Button>
                                <Button Tag="h2" Click="OnVisualToolClick" ToolTip="标题 2" AutomationProperties.Name="标题 2" Style="{StaticResource EditorToolButton}"><sketch:SketchIcon Kind="heading" Width="17" Height="17" /></Button>
                                <Button Tag="h3" Click="OnVisualToolClick" ToolTip="标题 3" AutomationProperties.Name="标题 3" Style="{StaticResource EditorToolButton}"><sketch:SketchIcon Kind="heading" Width="17" Height="17" /></Button>
                                <Button Tag="body" Click="OnVisualToolClick" ToolTip="正文" AutomationProperties.Name="正文" Style="{StaticResource EditorToolButton}"><sketch:SketchIcon Kind="notes" Width="17" Height="17" /></Button>
                            </StackPanel></Border>
                            <Border Style="{StaticResource ToolbarGroup}"><StackPanel Orientation="Horizontal">
                                <Button Tag="bullet" Click="OnVisualToolClick" ToolTip="项目符号列表" AutomationProperties.Name="项目符号列表" Style="{StaticResource EditorToolButton}"><sketch:SketchIcon Kind="bullet" Width="17" Height="17" /></Button>
                                <Button Tag="number" Click="OnVisualToolClick" ToolTip="编号列表" AutomationProperties.Name="编号列表" Style="{StaticResource EditorToolButton}"><sketch:SketchIcon Kind="number" Width="17" Height="17" /></Button>
                                <Button Tag="quote" Click="OnVisualToolClick" ToolTip="引用" AutomationProperties.Name="引用" Style="{StaticResource EditorToolButton}"><sketch:SketchIcon Kind="quote" Width="17" Height="17" /></Button>
                            </StackPanel></Border>
                            <Border Style="{StaticResource ToolbarGroup}"><StackPanel Orientation="Horizontal">
                                <Button Tag="code" Click="OnVisualToolClick" ToolTip="行内代码" AutomationProperties.Name="行内代码" Style="{StaticResource EditorToolButton}"><sketch:SketchIcon Kind="code" Width="17" Height="17" /></Button>
                                <Button Tag="link" Click="OnVisualToolClick" ToolTip="插入链接" AutomationProperties.Name="插入链接" Style="{StaticResource EditorToolButton}"><sketch:SketchIcon Kind="link" Width="17" Height="17" /></Button>
                                <Button Tag="rule" Click="OnVisualToolClick" ToolTip="分隔线" AutomationProperties.Name="分隔线" Style="{StaticResource EditorToolButton}"><sketch:SketchIcon Kind="rule" Width="17" Height="17" /></Button>
                                <Button Tag="time" Click="OnVisualToolClick" ToolTip="插入当前时间" AutomationProperties.Name="插入当前时间" Style="{StaticResource EditorToolButton}"><sketch:SketchIcon Kind="timer" Width="17" Height="17" /></Button>
                            </StackPanel></Border>
                            <Border x:Name="LinkPanel" Style="{StaticResource ToolbarGroup}" Visibility="Collapsed"><StackPanel Orientation="Horizontal">
                                <TextBox x:Name="LinkTextInput" Text="链接文字" Width="95" Padding="6,4" Margin="0,0,4,0" Background="#FFFCF3" ToolTip="链接显示文字" />
                                <TextBox x:Name="LinkUrlInput" Text="https://" Width="150" Padding="6,4" Margin="0,0,4,0" Background="#FFFCF3" ToolTip="链接网址" />
                                <Button Click="OnInsertLinkClick" Style="{StaticResource EditorToolButton}" Margin="0" ToolTip="插入链接" AutomationProperties.Name="插入链接"><sketch:SketchIcon Kind="check" Width="17" Height="17" /></Button>
                            </StackPanel></Border>
                        </WrapPanel>
                    </Border>
                    <Grid Grid.Row="3">
                        <ScrollViewer x:Name="EditorScrollViewer" Visibility="{Binding HasLogEditor, Converter={StaticResource RecordsVisibility}}" Background="#FFFCF3" BorderBrush="#D1C09F" BorderThickness="0.8" Padding="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                            <RichTextBox x:Name="DailyLogEditor" MinHeight="300" IsEnabled="{Binding CanEdit}" Background="Transparent" BorderThickness="0" Padding="12" FontSize="16" AcceptsTab="True" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" PreviewKeyDown="OnEditorPreviewKeyDown" SelectionChanged="OnEditorSelectionChanged" TextChanged="OnVisualEditorTextChanged" sketch:SketchMotion.Feedback="False" />
                        </ScrollViewer>
                        <FlowDocumentScrollViewer x:Name="MarkdownPreview" MinHeight="300" Visibility="Collapsed" IsToolBarVisible="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#FFFCF3" BorderBrush="#D1C09F" BorderThickness="0.8" Padding="0" />
                    </Grid>
                    <WrapPanel Grid.Row="4" Margin="0,16,0,0" HorizontalAlignment="Right"><Button Content="另存为" Command="{Binding SaveAsCommand}" Visibility="{Binding HasLogEditor, Converter={StaticResource RecordsVisibility}}" Margin="0,0,9,0" /><Button Command="{Binding SaveCommand}" Visibility="{Binding HasLogEditor, Converter={StaticResource RecordsVisibility}}" Style="{StaticResource PrimaryButton}"><StackPanel Orientation="Horizontal"><sketch:SketchIcon Kind="save" Width="17" Height="17" Margin="0,0,7,0" /><TextBlock Text="保存" FontFamily="{StaticResource HandwritingFont}" FontSize="16" /></StackPanel></Button></WrapPanel>
                </Grid>
            </sketch:SketchBorder>
            </Grid>
            <sketch:SketchBorder x:Name="DateChooserPanel" Style="{StaticResource Card}" Padding="28" Visibility="Collapsed" Background="#FFFCF4" sketch:SketchMotion.Enter="False">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="选择日志日期" FontFamily="{StaticResource HandwritingFont}" FontSize="26" FontWeight="Bold" />
                        <TextBlock Text="先选一个日期，再进入可视化日志编辑。滚动鼠标滚轮可以左右浏览时间轴。" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    </StackPanel>
                    <Border Grid.Row="1" Background="#F5ECD8" BorderBrush="#D1C09F" BorderThickness="0.8" CornerRadius="8" Padding="8" Margin="0,22,0,12">
                        <Grid>
                            <ScrollViewer x:Name="DateTimelineScroller" Margin="24,0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="HorizontalOnly" PreviewMouseWheel="OnDateTimelineMouseWheel">
                                <StackPanel x:Name="DateTimelineHost" Orientation="Horizontal" />
                            </ScrollViewer>
                            <Button x:Name="DateTimelineLeftButton" Click="OnDateTimelineLeftClick" HorizontalAlignment="Left" VerticalAlignment="Center" Width="34" Height="96" Padding="4" Background="#B8A787" BorderBrush="#8F7A5D" BorderThickness="0.8" Opacity="0.58" ToolTip="向左浏览日期" AutomationProperties.Name="向左浏览日期"><sketch:SketchIcon Kind="previous" Width="19" Height="19" Stroke="#5E5141" /></Button>
                            <Button x:Name="DateTimelineRightButton" Click="OnDateTimelineRightClick" HorizontalAlignment="Right" VerticalAlignment="Center" Width="34" Height="96" Padding="4" Background="#B8A787" BorderBrush="#8F7A5D" BorderThickness="0.8" Opacity="0.58" ToolTip="向右浏览日期" AutomationProperties.Name="向右浏览日期"><sketch:SketchIcon Kind="next" Width="19" Height="19" Stroke="#5E5141" /></Button>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <sketch:SketchIcon Kind="notes" Width="17" Height="17" Stroke="#D97962" Margin="0,0,7,0" />
                        <TextBlock Text="红点表示这一天已经写过日志" Style="{StaticResource Caption}" FontSize="13" />
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="{Binding DailyContextText}" Style="{StaticResource PageDescription}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Button Grid.Row="4" Content="打开今天" Click="OnChooseTodayClick" HorizontalAlignment="Center" Padding="18,9" Margin="0,14,0,0" Style="{StaticResource PrimaryButton}" />
                </Grid>
            </sketch:SketchBorder>
        </Grid>
        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Style="{StaticResource InlineStatus}" />
    </Grid>
</UserControl>
