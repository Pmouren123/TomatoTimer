<UserControl x:Class="TomatoTimerPro.Views.Components.Schedule.DayTimeAllocation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TomatoTimerPro.Views.Components.Schedule"
             xmlns:sketch="clr-namespace:TomatoTimerPro.Views.Components.Sketch">
    <sketch:SketchBorder Style="{StaticResource Card}" Padding="18,15">
        <StackPanel>
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" Text="{Binding WorkedText}" FontSize="16" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" ToolTip="当前工作区 · 今日实际专注，不含暂停时间" />
                <WrapPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="今日时间分配" FontSize="18" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding PlannedText}" FontSize="14" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                </WrapPanel>
            </DockPanel>
            <ItemsControl x:Name="AllocationSegments" ItemsSource="{Binding Segments}" AlternationCount="6" Margin="0,12,0,0" Height="29"
                          AutomationProperties.Name="今日计划时间分配">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:ProportionalPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="local:ProportionalPanel.Weight" Value="{Binding Fraction}" /></Style></ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <sketch:SketchBorder CornerRadius="5" BorderThickness="0.8" BorderBrush="#A28C6D" Margin="0,0,2,0" ClipToBounds="True">
                            <TextBlock TextTrimming="CharacterEllipsis" Margin="7,0" FontSize="13" VerticalAlignment="Center"><TextBlock.Text><MultiBinding StringFormat="{}{0}. {1}"><Binding Path="Number" /><Binding Path="Title" /></MultiBinding></TextBlock.Text></TextBlock>
                            <sketch:SketchBorder.ToolTip><TextBlock><TextBlock.Text><MultiBinding StringFormat="{}{0} · {1}"><Binding Path="Title" /><Binding Path="DurationText" /></MultiBinding></TextBlock.Text></TextBlock></sketch:SketchBorder.ToolTip>
                            <sketch:SketchBorder.Style>
                                <Style TargetType="sketch:SketchBorder">
                                    <Setter Property="Background" Value="#E9BEA5" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="1"><Setter Property="Background" Value="#B7C4A1" /></DataTrigger>
                                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="2"><Setter Property="Background" Value="#E8D49D" /></DataTrigger>
                                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="3"><Setter Property="Background" Value="#B7C9CD" /></DataTrigger>
                                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="4"><Setter Property="Background" Value="#C9B8CB" /></DataTrigger>
                                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="5"><Setter Property="Background" Value="#D5BB9F" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </sketch:SketchBorder.Style>
                        </sketch:SketchBorder>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl x:Name="AllocationLegend" ItemsSource="{Binding Segments}" Margin="0,8,0,0" AutomationProperties.Name="时间分配计划名称">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                    <TextBlock Margin="0,3,20,3" FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="300">
                        <TextBlock.Text><MultiBinding StringFormat="{}{0}. {1} · {2}"><Binding Path="Number" /><Binding Path="Title" /><Binding Path="DurationText" /></MultiBinding></TextBlock.Text>
                    </TextBlock>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </sketch:SketchBorder>
</UserControl>
