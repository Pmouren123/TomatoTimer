<Window x:Class="TomatoTimerPro.Views.Components.FloatingClock.FloatingClockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sketch="clr-namespace:TomatoTimerPro.Views.Components.Sketch"
        Title="Tomato · 悬浮时钟" Width="258" SizeToContent="Height" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" WindowStartupLocation="Manual" Left="30" Top="45"
        FontFamily="{StaticResource HandwritingFont}" Foreground="{StaticResource InkBrush}" UseLayoutRounding="True">
    <sketch:SketchBorder Background="#FFF3DDAA" BorderBrush="{StaticResource InkBrush}" BorderThickness="1.3" CornerRadius="11" Padding="16,12,16,14" Margin="2">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Margin="0,0,0,3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Background="Transparent" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown" Cursor="SizeAll" Padding="0,3">
                    <StackPanel Orientation="Horizontal"><sketch:SketchIcon Kind="pin" Width="15" Height="15" Stroke="#92754B" Margin="0,0,7,0" /><TextBlock Text="{Binding StatusText}" FontFamily="{StaticResource HandwritingFont}" FontSize="14" Foreground="#8A6D48" /></StackPanel>
                </Border>
                <Button Grid.Column="1" Command="{Binding HideCommand}" ToolTip="隐藏悬浮时钟" Width="24" Height="24" Background="Transparent" BorderThickness="0" Padding="4"><sketch:SketchIcon Kind="close" Width="14" Height="14" Stroke="#8A765B" /></Button>
            </Grid>
            <Button Grid.Row="4" Command="{Binding StopAlarmCommand}" Background="#E9B098" BorderBrush="#A97659" BorderThickness="1" Padding="8,7" Margin="0,9,0,0" FontSize="14">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsAlarmPlaying}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style>
                <StackPanel Orientation="Horizontal"><sketch:SketchIcon Kind="bell" Width="16" Height="16" Stroke="#83543E" Margin="0,0,7,0" /><TextBlock Text="停止铃声" FontSize="14" Foreground="#754C37" /></StackPanel>
            </Button>
            <TextBlock Grid.Row="1" Text="{Binding RemainingText}" FontFamily="Segoe Print" FontSize="38" FontWeight="Bold" Foreground="#51432E" HorizontalAlignment="Center" Margin="0,0,0,0" />
            <TextBlock Grid.Row="2" Text="{Binding CurrentTaskTitle}" Foreground="#9A805A" FontSize="12" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" MaxWidth="210" Margin="0,0,0,11" />
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Button Content="暂停 / 继续" Command="{Binding PauseResumeCommand}" Background="#ECC0A0" BorderBrush="#997556" BorderThickness="1" Padding="5,7" FontSize="14" />
                <Button Grid.Column="2" Content="打开主界面" Command="{Binding OpenMainCommand}" Background="#F7EAC7" BorderBrush="#A28A65" BorderThickness="1" Padding="5,7" FontSize="14" />
            </Grid>
        </Grid>
    </sketch:SketchBorder>
</Window>
