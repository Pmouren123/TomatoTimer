<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:sketch="clr-namespace:TomatoTimerPro.Views.Components.Sketch">
    <Style x:Key="SketchScrollArrow" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Delay" Value="350" />
        <Setter Property="Interval" Value="65" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="RepeatButton">
                <Grid Background="Transparent" Margin="1">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualStateGroup.Transitions>
                                <VisualTransition GeneratedDuration="0:0:0.14"><VisualTransition.GeneratedEasingFunction><CubicEase EasingMode="EaseOut" /></VisualTransition.GeneratedEasingFunction></VisualTransition>
                                <VisualTransition To="Pressed" GeneratedDuration="0:0:0.07" />
                            </VisualStateGroup.Transitions>
                            <VisualState x:Name="Normal"><Storyboard><DoubleAnimation Storyboard.TargetName="ArrowWash" Storyboard.TargetProperty="Opacity" To="0" Duration="0" /></Storyboard></VisualState>
                            <VisualState x:Name="MouseOver"><Storyboard><DoubleAnimation Storyboard.TargetName="ArrowWash" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0" /></Storyboard></VisualState>
                            <VisualState x:Name="Pressed"><Storyboard><DoubleAnimation Storyboard.TargetName="ArrowWash" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard></VisualState>
                            <VisualState x:Name="Disabled"><Storyboard><DoubleAnimation Storyboard.TargetName="ArrowInk" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0" /></Storyboard></VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <sketch:SketchBorder x:Name="ArrowWash" Background="#E5C69B" BorderBrush="#B99D78" BorderThickness="0.65" CornerRadius="4" Opacity="0" IsHitTestVisible="False" />
                    <ContentPresenter x:Name="ArrowInk" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="SketchScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" /><Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SketchScrollThumb" TargetType="Thumb">
        <Setter Property="MinWidth" Value="12" /><Setter Property="MinHeight" Value="24" />
        <Setter Property="Background" Value="#CDBB9C" /><Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Thumb">
                <Grid x:Name="ThumbChrome" Background="Transparent" Margin="1">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualStateGroup.Transitions>
                                <VisualTransition GeneratedDuration="0:0:0.16"><VisualTransition.GeneratedEasingFunction><CubicEase EasingMode="EaseOut" /></VisualTransition.GeneratedEasingFunction></VisualTransition>
                                <VisualTransition To="Pressed" GeneratedDuration="0:0:0.07"><VisualTransition.GeneratedEasingFunction><QuadraticEase EasingMode="EaseOut" /></VisualTransition.GeneratedEasingFunction></VisualTransition>
                            </VisualStateGroup.Transitions>
                            <VisualState x:Name="Normal"><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ThumbWash" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                <DoubleAnimation Storyboard.TargetName="Grip" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0" />
                            </Storyboard></VisualState>
                            <VisualState x:Name="MouseOver"><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ThumbWash" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0" />
                                <DoubleAnimation Storyboard.TargetName="Grip" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0" />
                            </Storyboard></VisualState>
                            <VisualState x:Name="Pressed"><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ThumbWash" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                <DoubleAnimation Storyboard.TargetName="Grip" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                            </Storyboard></VisualState>
                            <VisualState x:Name="Disabled"><Storyboard><DoubleAnimation Storyboard.TargetName="ThumbChrome" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0" /></Storyboard></VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <sketch:SketchBorder x:Name="ThumbPaper" Background="{TemplateBinding Background}" BorderBrush="#9C896D" BorderThickness="0.85" CornerRadius="5" />
                    <sketch:SketchBorder x:Name="ThumbWash" Background="#D99B77" BorderBrush="#8E7056" BorderThickness="1" CornerRadius="5" Opacity="0" IsHitTestVisible="False" />
                    <Path x:Name="Grip" Data="M 3,1 L 8,1.4 M 2.5,4 L 8.5,4.4 M 3,7 L 8,7.4" Width="11" Height="9" Stroke="#78634C" StrokeThickness="0.85" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.55" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
                <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal">
                        <Setter TargetName="Grip" Property="Data" Value="M 1,3 L 1.4,8 M 4,2.5 L 4.4,8.5 M 7,3 L 7.4,8" />
                        <Setter TargetName="Grip" Property="Width" Value="9" /><Setter TargetName="Grip" Property="Height" Value="11" />
                    </DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="SketchScrollBar" TargetType="ScrollBar">
        <Style.Resources>
            <!-- Track reserves half these metrics as its minimum thumb length.
                 Keep its layout calculation consistent with the thumb's minimum,
                 so dragging to the end never arranges a larger thumb off-track. -->
            <system:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">48</system:Double>
            <system:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}">48</system:Double>
        </Style.Resources>
        <Setter Property="Width" Value="18" /><Setter Property="Margin" Value="3,0,1,0" />
        <Setter Property="Focusable" Value="False" /><Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#CDBB9C" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
                <Grid x:Name="ScrollChrome" Background="{TemplateBinding Background}">
                    <sketch:SketchBorder x:Name="ScrollRail" Background="#F0E7D4" BorderBrush="#D4C6AF" BorderThickness="0.65" CornerRadius="5" Margin="2,0" IsHitTestVisible="False" />
                    <DockPanel LastChildFill="True">
                        <RepeatButton x:Name="LineDecrease" DockPanel.Dock="Top" Height="18" Style="{StaticResource SketchScrollArrow}" Command="{x:Static ScrollBar.LineUpCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" AutomationProperties.Name="向上滚动">
                            <Path x:Name="DecreaseInk" Data="M 1,5 Q 4,0 7,4.6" Width="9" Height="7" Stroke="#968269" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </RepeatButton>
                        <RepeatButton x:Name="LineIncrease" DockPanel.Dock="Bottom" Height="18" Style="{StaticResource SketchScrollArrow}" Command="{x:Static ScrollBar.LineDownCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" AutomationProperties.Name="向下滚动">
                            <Path x:Name="IncreaseInk" Data="M 1,1 Q 4,6 7,1.4" Width="9" Height="7" Stroke="#968269" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </RepeatButton>
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"
                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                            <Track.DecreaseRepeatButton><RepeatButton x:Name="PageDecrease" Style="{StaticResource SketchScrollPage}" Command="{x:Static ScrollBar.PageUpCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" /></Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb x:Name="ScrollThumb" Style="{StaticResource SketchScrollThumb}" Background="{TemplateBinding Foreground}" /></Track.Thumb>
                            <Track.IncreaseRepeatButton><RepeatButton x:Name="PageIncrease" Style="{StaticResource SketchScrollPage}" Command="{x:Static ScrollBar.PageDownCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" /></Track.IncreaseRepeatButton>
                        </Track>
                    </DockPanel>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        <Setter TargetName="ScrollRail" Property="Margin" Value="0,2" />
                        <Setter TargetName="LineDecrease" Property="DockPanel.Dock" Value="Left" /><Setter TargetName="LineIncrease" Property="DockPanel.Dock" Value="Right" />
                        <Setter TargetName="LineDecrease" Property="Width" Value="18" /><Setter TargetName="LineDecrease" Property="Height" Value="Auto" />
                        <Setter TargetName="LineIncrease" Property="Width" Value="18" /><Setter TargetName="LineIncrease" Property="Height" Value="Auto" />
                        <Setter TargetName="DecreaseInk" Property="Data" Value="M 5,1 Q 0,4 4.6,7" /><Setter TargetName="IncreaseInk" Property="Data" Value="M 1,1 Q 6,4 1.4,7" />
                        <Setter TargetName="LineDecrease" Property="Command" Value="{x:Static ScrollBar.LineLeftCommand}" /><Setter TargetName="LineIncrease" Property="Command" Value="{x:Static ScrollBar.LineRightCommand}" />
                        <Setter TargetName="LineDecrease" Property="AutomationProperties.Name" Value="向左滚动" /><Setter TargetName="LineIncrease" Property="AutomationProperties.Name" Value="向右滚动" />
                        <Setter TargetName="PageDecrease" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}" /><Setter TargetName="PageIncrease" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}" />
                        <Setter TargetName="ScrollThumb" Property="MinWidth" Value="24" /><Setter TargetName="ScrollThumb" Property="MinHeight" Value="12" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ScrollChrome" Property="Opacity" Value="0.35" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto" /><Setter Property="Height" Value="18" /><Setter Property="Margin" Value="0,3,0,1" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource SketchScrollBar}" />
    <!-- Explicit scrollbar styles also cover controls whose content host is created by a Windows theme template. -->
    <Style TargetType="ScrollViewer">
        <Setter Property="sketch:SketchScrollMotion.Enabled" Value="True" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ScrollViewer">
                <Grid Background="{TemplateBinding Background}" ClipToBounds="True">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}"
                                            CanContentScroll="{TemplateBinding CanContentScroll}" Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                            ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                    <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical" Style="{StaticResource SketchScrollBar}"
                               Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                               Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" Style="{StaticResource SketchScrollBar}"
                               Minimum="0" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                               Value="{TemplateBinding HorizontalOffset}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                </Grid>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
</ResourceDictionary>
